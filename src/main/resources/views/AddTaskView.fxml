<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" spacing="14" prefWidth="420" styleClass="add-task-container" stylesheets="@AddTaskView.css">

    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <!-- Title -->

    <Label text="Create New Task" styleClass="form-title"/>

    <!-- Form Fields -->

    <VBox spacing="6">
        <Label text="Task Name" styleClass="form-label"/>
        <TextField fx:id="taskNameField" promptText="Enter task name..." styleClass="form-input"/>
    </VBox>

    <!-- Due Date -->

    <VBox spacing="6">
        <Label text="Due Date" styleClass="form-label"/>
        <DatePicker fx:id="dueDatePicker" promptText="Select a deadline" maxWidth="Infinity" styleClass="form-input"/>
    </VBox>

    <!-- Subtasks -->

    <VBox spacing="6">
        <Label text="Subtasks" styleClass="form-label"/>

        <VBox fx:id="subtaskList" spacing="6">
            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="subtask-row">
                <CheckBox/>
                <TextField promptText="Enter a subtask..." HBox.hgrow="ALWAYS" styleClass="subtask-input"/>
            </HBox>
        </VBox>

        <Button text="+ Add Subtask" styleClass="add-subtask-button"/>
    </VBox>

    <Region VBox.vgrow="ALWAYS"/>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button text="Cancel" styleClass="cancel-button"/>
        <Button text="Create Task" styleClass="create-task-button"/>
    </HBox>

</VBox>